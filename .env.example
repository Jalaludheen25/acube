# Public URL of the deployed site — used for canonical URLs, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (https://resend.com). Without these, the form
# logs submissions in development and returns an error in production
# (visitors are then shown the direct email/WhatsApp fallback).
RESEND_API_KEY=
CONTACT_TO_EMAIL=acubedubai@gmail.com
CONTACT_FROM_EMAIL=ACUBE Website <website@your-verified-domain.com>
